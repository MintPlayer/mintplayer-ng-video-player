{
  "cli": {
    "packageManager": "npm"
  },
  "generators": {
    "@nrwl/angular:application": {
      "style": "scss",
      "linter": "eslint",
      "unitTestRunner": "jest",
      "e2eTestRunner": "playwright"
    },
    "@nrwl/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "jest"
    },
    "@nrwl/angular:component": {
      "style": "scss"
    },
    "@nx/angular:application": {
      "style": "css",
      "linter": "eslint",
      "unitTestRunner": "jest",
      "e2eTestRunner": "none"
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "jest"
    },
    "@nx/angular:component": {
      "style": "css"
    },
    "@nx/react": {
      "library": {
        "style": "scss",
        "linter": "eslint",
        "unitTestRunner": "none"
      },
      "application": {
        "babel": true,
        "style": "scss",
        "linter": "eslint",
        "bundler": "vite"
      },
      "component": {
        "style": "scss"
      }
    },
    "@nx/vue": {
      "application": {
        "bundler": "vite",
        "style": "scss",
        "linter": "eslint",
        "unitTestRunner": "vitest",
        "e2eTestRunner": "playwright"
      },
      "library": {
        "bundler": "vite",
        "linter": "eslint",
        "unitTestRunner": "vitest"
      }
    }
  },
  "defaultProject": "angular-demo",
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": [
      {
        "dependsOn": ["^build"],
        "inputs": ["production", "^production"],
        "cache": true
      },
      {
        "filter": {
          "plugin": "@nx/vite/plugin"
        },
        "defaultConfiguration": "production",
        "configurations": {
          "development": {
            "mode": "development"
          },
          "production": {
            "mode": "production"
          }
        }
      }
    ],
    "e2e": {
      "inputs": ["default", "^production"],
      "cache": true
    },
    "lint": [
      {
        "inputs": ["default", "{workspaceRoot}/eslint.config.mjs"],
        "cache": true
      },
      {
        "filter": {
          "plugin": "@nx/eslint/plugin"
        },
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/eslint.config.mjs",
          "{workspaceRoot}/tools/eslint-rules/**/*"
        ]
      }
    ],
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/esbuild:esbuild": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "test": [
      {
        "cache": true
      },
      {
        "filter": {
          "plugin": "@nx/jest/plugin"
        },
        "dependsOn": ["^test"],
        "configurations": {
          "ci": {
            "ci": true,
            "coverage": true
          }
        },
        "options": {
          "passWithNoTests": true
        }
      }
    ]
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/src/test-setup.[jt]s"
    ]
  },
  "tasksRunnerOptions": {
    "default": {
      "runner": "@nx/workspace/tasks-runners/default",
      "options": {
        "cacheableOperations": []
      }
    }
  },
  "useDaemonProcess": false,
  "useInferencePlugins": false,
  "defaultBase": "master",
  "release": {
    "version": {
      "preVersionCommand": "npx nx run-many -t build"
    }
  },
  "analytics": true,
  "affected": {
    "legacy": true
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "include": [
        "apps/angular-demo/**/*",
        "apps/angular-demo-e2e/**/*",
        "apps/react-demo/**/*",
        "apps/react-demo-e2e/**/*",
        "apps/vue-demo/**/*",
        "apps/vue-demo-e2e/**/*",
        "libs/frameworks/ng-video-player/**/*",
        "libs/frameworks/r-video-player/**/*",
        "libs/frameworks/vue-video-player/**/*",
        "libs/ng-canvas-resizer/**/*",
        "libs/platforms/dailymotion-player/**/*",
        "libs/platforms/facebook-player/**/*",
        "libs/platforms/file-player/**/*",
        "libs/platforms/mixcloud-player/**/*",
        "libs/platforms/soundcloud-player/**/*",
        "libs/platforms/spotify-player/**/*",
        "libs/platforms/streamable-player/**/*",
        "libs/platforms/twitch-player/**/*",
        "libs/platforms/vidyard-player/**/*",
        "libs/platforms/vimeo-player/**/*",
        "libs/platforms/wistia-player/**/*",
        "libs/platforms/youtube-player/**/*",
        "libs/player-progress/**/*",
        "libs/player-provider/**/*",
        "libs/playlist-controller/**/*",
        "libs/video-player/**/*"
      ]
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      },
      "include": [
        "apps/angular-demo/**/*",
        "apps/react-demo/**/*",
        "libs/frameworks/ng-video-player/**/*",
        "libs/ng-canvas-resizer/**/*",
        "libs/platforms/dailymotion-player/**/*",
        "libs/platforms/facebook-player/**/*",
        "libs/platforms/file-player/**/*",
        "libs/platforms/mixcloud-player/**/*",
        "libs/platforms/soundcloud-player/**/*",
        "libs/platforms/spotify-player/**/*",
        "libs/platforms/streamable-player/**/*",
        "libs/platforms/twitch-player/**/*",
        "libs/platforms/vidyard-player/**/*",
        "libs/platforms/vimeo-player/**/*",
        "libs/platforms/wistia-player/**/*",
        "libs/platforms/youtube-player/**/*",
        "libs/player-progress/**/*",
        "libs/player-provider/**/*",
        "libs/playlist-controller/**/*",
        "libs/video-player/**/*"
      ]
    },
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        }
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "devTargetName": "dev",
        "typecheckTargetName": "typecheck",
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testMode": "watch",
        "testTargetName": "test"
      },
      "include": [
        "apps/vue-demo/**/*",
        "libs/frameworks/r-video-player/**/*",
        "libs/frameworks/vue-video-player/**/*",
        "tools/**/*"
      ]
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e",
        "ciTargetName": "e2e-ci"
      }
    }
  ]
}
